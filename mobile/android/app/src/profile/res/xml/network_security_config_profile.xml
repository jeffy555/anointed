<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext for loopback only. 127.0.0.1 is where `adb reverse` delivers the
     developer machine's backend on a physical device; 10.0.2.2 is the Android
     emulator's alias for the same thing. Every other destination keeps the
     platform default, which refuses cleartext. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
