<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Profile builds talk to a backend on the developer's machine over
         `adb reverse tcp:8000 tcp:8000`, which arrives as plain http on
         127.0.0.1. Cleartext is blocked by default from targetSdk 28, so
         without this the request fails before it leaves the device and the app
         sits on the splash screen.

         Scoped deliberately: this file is the `profile` source set only, so it
         is merged into profile builds and never into release. The config it
         points at permits loopback and nothing else, so even a profile build
         cannot be talked into sending cleartext to a real host. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_profile"
        tools:replace="android:networkSecurityConfig" />
</manifest>
