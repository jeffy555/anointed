	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- RELEASE BLOCKER: this is Google's public sample application id, not ours.
	     It serves test ads that earn nothing and attribute to nobody. Replace it
	     with the real AdMob app id before any TestFlight or App Store build.
	     Android refuses to assemble a release while its equivalent is unset
	     (see android/app/build.gradle, task verifyReleaseConfig); iOS has no
	     equivalent build-time guard, so this one is on the checklist instead:
	     docs/ios_release_checklist.md -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<!-- Ad attribution on iOS. Only Google's own network is listed here, which
	     is the one this app actually serves through; AdMob mediation partners
	     each need their own entry, and the authoritative list is published by
	     Google at developers.google.com/admob/ios/quick-start#skadnetwork.
	     Paste the current list before submission — this is a starting point,
	     not a complete one. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<!-- The app uses only standard HTTPS, which is exempt from the US export
	     regulations App Store Connect asks about. Declaring it here answers the
	     question once instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
