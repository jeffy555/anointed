# ---------------------------------------------------------------- secrets
backend/.env
backend/.env.*
!backend/.env.example

mobile/android/key.properties
mobile/android/local.properties
mobile/**/*.keystore
mobile/**/*.jks
mobile/**/*.p12
mobile/**/*.pem
mobile/**/google-services.json
mobile/**/GoogleService-Info.plist

# ---------------------------------------------------------------- backend (Python)
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
backend/anointed_dev.db

# ---------------------------------------------------------------- local dev tooling (not source)
tools/
# A second Flutter SDK checkout that ended up at the project root. It has its own
# .git, so `git add .` recorded it as a gitlink (a bare commit-SHA pointer, no
# actual files) instead of source — shows up on GitHub as a broken folder icon,
# and a fresh clone gets an empty directory. tools/flutter-win is the real SDK
# every build script uses; this one is untracked, not deleted, in case it matters.
.flutter/

# ---------------------------------------------------------------- build output / large binaries
dist/*.apk
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/android/build/

# ---------------------------------------------------------------- local session state
.claude/scheduled_tasks.lock

# ---------------------------------------------------------------- OS / editor
.DS_Store
*.log
