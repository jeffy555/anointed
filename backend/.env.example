# Anointed API — copy to `.env` in this directory (or project root).
# All values shown are safe development defaults unless marked REQUIRED for production.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# Local dev (no Postgres install): SQLite file in this directory.
DATABASE_URL=sqlite:///./anointed_dev.db
# Neon / production example:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ---------------------------------------------------------------- auth (REQUIRED in production)
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

# Comma-separated Google OAuth client IDs (Android, iOS, Web)
GOOGLE_OAUTH_CLIENT_IDS=534331923421-hkmkr6udcsjdpnpmqtfmn9cn1c1hns88.apps.googleusercontent.com,534331923421-c28ata5t344743749pl7epediju17mju.apps.googleusercontent.com

# Sign in with Apple — bundle ID is enough for native token verification
APPLE_BUNDLE_IDS=com.anointed.app
APPLE_SERVICE_IDS=

# ---------------------------------------------------------------- VPC email (Path B)
CONSENT_EMAIL_FROM=no-reply@anointed.app
CONSENT_EMAIL_FROM_NAME=Anointed
CONSENT_TOKEN_TTL_HOURS=72
CONSENT_RESEND_COOLDOWN_SECONDS=60
CONSENT_POLICY_VERSION=2026-09-01

# Email provider: sendgrid | resend | ses | none
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_API_BASE=

# ---------------------------------------------------------------- IAP
IAP_PRODUCT_ID=com.anointed.app.unlock_levels
IAP_PRICE_DISPLAY=₹49
APPLE_IAP_SHARED_SECRET=
APPLE_IAP_USE_SANDBOX=false
GOOGLE_PLAY_PACKAGE_NAME=com.anointed.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------- AdMob (13+ only on client; server logs impressions)
ADMOB_APP_ID_ANDROID=
ADMOB_APP_ID_IOS=
ADMOB_INTERSTITIAL_UNIT_ANDROID=
ADMOB_INTERSTITIAL_UNIT_IOS=
# Set true only after completing docs/admob_coppa_checklist.md (production only).
ADMOB_PRODUCTION_ACK=false

# ---------------------------------------------------------------- admin (REQUIRED in production)
ADMIN_SESSION_SECRET=dev-only-admin-session-secret-change-me
# Optional bootstrap admin created on first boot if both are set:
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------- force upgrade
MINIMUM_APP_VERSION=1.0.0
CURRENT_STORE_VERSION=1.0.0
MINIMUM_APP_BUILD=1
APP_STORE_URL=https://apps.apple.com/app/id0000000000
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.anointed.app

# ---------------------------------------------------------------- links
PRIVACY_POLICY_URL=https://anointed.app/privacy
TERMS_OF_SERVICE_URL=https://anointed.app/terms
SUPPORT_EMAIL=support@anointed.app

# ---------------------------------------------------------------- CORS
# Comma-separated origins for /admin and /consent web. Do NOT use * in production.
CORS_ORIGINS=*
